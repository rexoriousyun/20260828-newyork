// Reliable Transit — data model
//
// Scope note: this schema covers M1 (ingestion) and M2 (the Min Gap audit),
// plus the GTFS tables M3/M5 will need. Segment tables arrive in M3, once the
// M2 gate confirms which metric we are building on (see docs/product/PLAN.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One row per incident as published by the TTC.
/// Stored verbatim — filtering (zero-minute records, terminals) happens in the
/// domain layer, never at ingest, so the raw record stays auditable (P-08).
model DelayIncident {
  id          Int      @id @default(autoincrement())
  mode        String   // "subway" | "bus" | "streetcar"
  occurredAt  DateTime // date + time combined, local Toronto time
  dayOfWeek   String
  hour        Int      // 0-23, denormalised for time-of-day queries

  /// Raw location string as published. Subway: "BATHURST STATION".
  /// Surface: free-text intersection, e.g. "KING AND PARLIAMENT" (E-D07).
  locationRaw String
  /// Route or line as published: "YU", "BD", "SHP", "52 LAWRENCE WEST".
  lineRaw     String

  code        String
  /// Vehicle lateness in minutes. Diagnostic only — NOT the headline metric (D-02).
  minDelay    Int
  /// Headway gap left behind, in minutes. The rider-facing metric (D-02, E-D09).
  minGap      Int
  bound       String?
  vehicle     String?

  sourceFile  String   // provenance for P-08
  ingestedAt  DateTime @default(now())

  /// Set by the attribution pass (M3). Null means unattributed — either a
  /// non-revenue location, or a name we refused to guess at (P-03, P-08).
  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id])

  @@index([segmentId])
  @@index([mode, lineRaw])
  @@index([mode, locationRaw])
  @@index([occurredAt])
  @@index([code])
}

/// TTC delay cause codes, per mode.
model DelayCode {
  code        String
  mode        String
  description String

  @@id([code, mode])
}

/// GTFS stops. Used to resolve surface delay locations to coordinates (M5).
model Stop {
  id        String  @id
  name      String
  lat       Float
  lon       Float
  /// Normalised street pair for intersection matching, e.g. "KING|PARLIAMENT".
  streetKey String?

  @@index([streetKey])
  @@index([name])
}

/// GTFS routes.
model Route {
  id        String @id
  shortName String
  longName  String
  /// GTFS route_type: 0 streetcar, 1 subway, 3 bus.
  type      Int

  @@index([shortName])
}

/// Records each ingest run so published numbers trace to a data window (P-08).
model IngestRun {
  id          Int      @id @default(autoincrement())
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  source      String
  rowsRead    Int      @default(0)
  rowsWritten Int      @default(0)
  windowStart DateTime?
  windowEnd   DateTime?
  notes       String?
}

/// An inter-stop segment: the stretch a rider actually traverses.
///
/// This is the product's core unit (D-01). Delay data is published against a
/// point, so incidents are attributed to the segment *arriving* at that point in
/// that direction — what a through-rider experiences (D-10).
model Segment {
  id          String @id // "1:N:UNION->KING" — stable across rebuilds
  mode        String @default("subway") // subway | bus | streetcar
  routeId     String
  direction   String // N | S | E | W
  fromStation String
  toStation   String
  sequence    Int    // position along the line, for ordering

  /// Surface segments key on GTFS stops; subway segments key on station names,
  /// because delay data identifies subway locations by station, not by platform.
  fromStopId String?
  toStopId   String?

  fromLat Float?
  fromLon Float?
  toLat   Float?
  toLon   Float?

  /// True when `toStation` is a line terminal. Terminal approaches accumulate
  /// turnaround incidents that never affect through-riders (E-D03, D-06).
  isTerminalApproach Boolean @default(false)

  incidents DelayIncident[]

  // No composite unique on names: distinct surface stops can share a stop_name
  // (the same corner appears on both sides of the street). Identity lives in the
  // primary key, which encodes stop ids for surface and station names for subway.
  @@index([routeId, direction, sequence])
  @@index([mode, routeId])
  @@index([toStopId])
}
