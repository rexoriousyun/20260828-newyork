{
  "name": "reliable-transit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "ingest": "tsx src/ingest/index.ts",
    "audit:gap": "tsx src/audit/min-gap-audit.ts",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:stability": "tsx src/audit/segment-stability.ts",
    "audit:coverage": "tsx src/audit/surface-coverage.ts",
    "audit:timeofday": "tsx src/audit/time-of-day.ts",
    "benchmark": "tsx src/benchmark/build.ts",
    "audit:headway": "tsx src/audit/headway.ts",
    "check:diagrams": "node scripts/check-diagrams.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
